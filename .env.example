# ============================================================================
# Display Foresight - Environment Variables Template (.env.example)
# 본 파일을 복사하여 `.env` 파일을 생성한 뒤 실제 발급받은 API 키를 입력하세요.
# cp .env.example .env
# ============================================================================

# [Phase 2-1] KIPRIS Plus (특허정보넷) OpenAPI 인증키 (Service Key)
# 발급처: https://plus.kipris.or.kr/ (KIPRIS Plus -> 마이페이지 -> 인증키 관리)
# 주의: URL Encoding 되지 않은 원본(Decoding) 키 또는 Encoding 키 모두 호환 처리됩니다.
KIPRIS_API_KEY=your_kipris_openapi_service_key_here

# [Phase 3-1 & 3-2] OpenAI API Key (gpt-4o-mini / gpt-4o)
# 발급처: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
